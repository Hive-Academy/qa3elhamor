{
  "name": "@qa3elhamor/content-data-access",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "content-data-access",
    "tags": [
      "scope:content",
      "type:data-access",
      "platform:shared"
    ],
    "targets": {
      "validate": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "default",
          "^production"
        ],
        "outputs": [],
        "options": {
          "command": "tsx libs/content/data-access/src/bin/validate-content.ts"
        }
      }
    }
  },
  "dependencies": {
    "@qa3elhamor/content-domain": "*",
    "@qa3elhamor/content-files": "*"
  }
}
