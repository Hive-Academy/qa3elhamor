# Copy to `.env` for local development. `.env` is git-ignored; Nx loads it into tasks and the
# API dev server reads it. In production set these as Netlify environment variables.

# --- Complaints wall API (apps/api) -------------------------------------------------------

# Postgres connection. Unset = no wall: wall endpoints answer 503 "wall-unavailable" while
# the site and /api/health keep working. Matches docker-compose.yml.
DATABASE_URL=postgresql://qa3elhamor:qa3elhamor@localhost:15432/qa3elhamor

# HMAC key for hashing client IPs in the rate-limit log (raw IPs are never stored).
# At least 24 characters; unset disables submissions (503). Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
IP_HASH_SALT=change-me-local-dev-salt-0123456789

# Bearer token for /api/moderation/*. At least 24 characters; unset disables moderation (503).
MODERATION_TOKEN=change-me-local-dev-moderation-token

# Submission limits per client: comma-separated max/windowSeconds. Default: 3/600,20/86400
# RATE_LIMITS=3/600,20/86400

# Extra origins allowed to call the API cross-origin (same-origin always works). The web dev
# server runs on another port, so allow it locally.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Route prefix (default /api) and the platform header carrying the client IP (default
# x-nf-client-connection-ip, set by Netlify's edge). Never point it at a client-forgeable header.
# API_BASE_PATH=/api
# CLIENT_IP_HEADER=x-nf-client-connection-ip

# What to do with a submission whose client-IP header is missing or not an IP address.
# reject (default; the only safe production value) answers 503 client-ip-unavailable and logs
# it, since it means CLIENT_IP_HEADER is wrong. shared puts all such requests in ONE rate-limit
# bucket (one client can then lock out the rest): local tooling only. The dev server always sets
# the header from the socket, so it does not need this. IPv6 clients are limited per /64.
# CLIENT_IP_FALLBACK=reject

# Dev server port (npm run api:dev).
# API_PORT=8787

# Integration suite database (nx run api:integration). Defaults to the compose test database.
# INTEGRATION_DATABASE_URL=postgresql://qa3elhamor:qa3elhamor@localhost:15432/qa3elhamor_test
