{
  "name": "@qa3elhamor/web-e2e",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "nx": {
    "name": "web-e2e",
    "tags": [
      "type:e2e",
      "platform:node"
    ],
    "implicitDependencies": [
      "web"
    ],
    "targets": {
      "typecheck": {
        "command": "tsc -p tsconfig.json --noEmit",
        "options": {
          "cwd": "{projectRoot}"
        }
      },
      "e2e": {
        "command": "playwright test",
        "cache": false,
        "options": {
          "cwd": "{projectRoot}"
        }
      },
      "e2e-update-snapshots": {
        "command": "playwright test --project=visual --update-snapshots",
        "cache": false,
        "options": {
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
