{
  "name": "@qa3elhamor/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "api",
    "tags": [
      "type:app",
      "platform:serverless"
    ],
    "targets": {
      "serve": {
        "continuous": true,
        "dependsOn": [
          "^prisma-generate"
        ],
        "command": "node --env-file-if-exists=.env --import tsx apps/api/src/dev-server.ts",
        "options": {
          "cwd": "{workspaceRoot}"
        }
      },
      "integration": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^prisma-generate"
        ],
        "cache": false,
        "options": {
          "cwd": "{projectRoot}",
          "commands": [
            "docker compose -f ../../docker-compose.yml up -d --wait postgres",
            "vitest run --config vitest.integration.config.mts"
          ],
          "parallel": false
        }
      }
    }
  },
  "dependencies": {
    "@qa3elhamor/complaints-data-access": "*",
    "@qa3elhamor/complaints-feature-api": "*",
    "@qa3elhamor/shared-api-interfaces": "*"
  }
}
